# Uploaded files are served as plain files and never run as code.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phar|php\d|pl|py|cgi|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
